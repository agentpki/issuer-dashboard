# Copy this file to .env.local and fill in real values.

# ───── Neon Postgres ─────
# Create a project at https://console.neon.tech
# Copy the pooled connection string.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.aws.neon.tech/agentpki?sslmode=require

# ───── NextAuth.js ─────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=<32+ random bytes base64>
NEXTAUTH_URL=http://localhost:3000

# ───── Resend (email magic-link auth) ─────
# Sign up at https://resend.com  (free 100/day)
# Verify the agentpki.dev domain there.
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=hello@agentpki.dev

# ───── Key encryption ─────
# Private signing keys are AES-256-GCM encrypted before storing in Postgres.
# Generate: openssl rand -base64 32
# Rotate this key requires re-encrypting all stored keys. Treat as load-bearing.
KEY_ENCRYPTION_KEY=<32 random bytes base64>
